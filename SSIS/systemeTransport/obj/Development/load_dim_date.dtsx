  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\SQL_Load_Dim_Date"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tâche d'exécution de requêtes SQL"
      DTS:DTSID="{14F20169-F393-4712-9017-F897B277F928}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Load_Dim_Date"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{4F0A28CC-B562-4258-8D7E-D46373928E34}"
          SQLTask:SqlStatementSource="SET DATEFIRST 1;&#xA;&#xA;;WITH Dates AS&#xA;(&#xA;    SELECT CAST('2026-01-01' AS DATE) AS date_complete&#xA;&#xA;    UNION ALL&#xA;&#xA;    SELECT DATEADD(DAY, 1, date_complete)&#xA;    FROM Dates&#xA;    WHERE date_complete &lt; '2026-12-31'&#xA;)&#xA;INSERT INTO dbo.Dim_Date&#xA;(&#xA;    id_date,&#xA;    date_complete,&#xA;    jour,&#xA;    nom_jour,&#xA;    mois,&#xA;    nom_mois,&#xA;    trimestre,&#xA;    annee&#xA;)&#xA;SELECT&#xA;    YEAR(D.date_complete) * 10000&#xA;        + MONTH(D.date_complete) * 100&#xA;        + DAY(D.date_complete),&#xA;&#xA;    D.date_complete,&#xA;&#xA;    DAY(D.date_complete),&#xA;&#xA;    CASE DATEPART(WEEKDAY, D.date_complete)&#xA;        WHEN 1 THEN 'Lundi'&#xA;        WHEN 2 THEN 'Mardi'&#xA;        WHEN 3 THEN 'Mercredi'&#xA;        WHEN 4 THEN 'Jeudi'&#xA;        WHEN 5 THEN 'Vendredi'&#xA;        WHEN 6 THEN 'Samedi'&#xA;        WHEN 7 THEN 'Dimanche'&#xA;    END,&#xA;&#xA;    MONTH(D.date_complete),&#xA;&#xA;    CASE MONTH(D.date_complete)&#xA;        WHEN 1 THEN 'Janvier'&#xA;        WHEN 2 THEN 'Février'&#xA;        WHEN 3 THEN 'Mars'&#xA;        WHEN 4 THEN 'Avril'&#xA;        WHEN 5 THEN 'Mai'&#xA;        WHEN 6 THEN 'Juin'&#xA;        WHEN 7 THEN 'Juillet'&#xA;        WHEN 8 THEN 'Août'&#xA;        WHEN 9 THEN 'Septembre'&#xA;        WHEN 10 THEN 'Octobre'&#xA;        WHEN 11 THEN 'Novembre'&#xA;        WHEN 12 THEN 'Décembre'&#xA;    END,&#xA;&#xA;    DATEPART(QUARTER, D.date_complete),&#xA;&#xA;    YEAR(D.date_complete)&#xA;&#xA;FROM Dates D&#xA;WHERE NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dbo.Dim_Date DD&#xA;    WHERE DD.date_complete = D.date_complete&#xA;)&#xA;OPTION (MAXRECURSION 0);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
